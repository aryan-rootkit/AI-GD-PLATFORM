# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local dev data
.local-data/

# python / ai-service
ai-service/venv/
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/sessions/
ai-service/temp_audio/
ai-service/bin/
venv/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / tooling
.cursor/
scripts/_fix_div.py

# large model binaries (install via scripts)
ai-service/voices/*.onnx
ai-service/voices/*.onnx.json
