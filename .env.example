# Next.js app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Local file DB + auth (no Firebase)
USE_LOCAL_DEV=true
NEXT_PUBLIC_USE_LOCAL_DEV=true

# Open-source voice pipeline (whisper.cpp + Ollama + Piper)
NEXT_PUBLIC_USE_VOICE_PIPELINE=true
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_URL=http://localhost:8001

# Legacy Vapi (used when NEXT_PUBLIC_USE_VOICE_PIPELINE=false)
# NEXT_PUBLIC_VAPI_WEB_TOKEN=
# NEXT_PUBLIC_VAPI_WORKFLOW_ID=

# Optional cloud AI (Gemini) for question/feedback generation
# GOOGLE_GENERATIVE_AI_API_KEY=

# Firebase (production — disable local dev flags above)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
