# Monorepo env hints (copy values into the right place — see below).
#
# Flow:  React Native (client/)  →  Backend on Render (Server/)  →  DB cluster
#        The app NEVER uses MongoDB/Postgres URLs directly.

# --- Vercel (Next.js in `web/`) ---
# In the Vercel project: Settings → General → Root Directory = `web` (not repo root, not `client/`).
# Env vars for the web app live in Vercel as NEXT_PUBLIC_* (see `web/.env.local.example`).

# --- Expo client (`client/.env`) — public vars only ---
# EXPO_PUBLIC_API_URL=https://your-api.onrender.com

# --- Backend (`Server/.env` or Render Environment) — secrets & DB ---
# PORT= (set by Render)
# REDIS_URL=
# JWT_SECRET=
# CLIENT_ORIGIN=https://your-app.vercel.app
# (comma-separated for multiple: production + preview URLs; localhost is always allowed by the API)
# DATABASE_URL=    (Postgres, if used)
# MONGO_URI=       (Atlas — server only; alias MONGODB_URI also supported)
