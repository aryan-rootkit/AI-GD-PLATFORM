# === Backend only (Render / local). Never put these in the Expo app. ===
#
# React Native → HTTPS/WSS → this API → DB (here only).

# Render sets PORT automatically — do not hardcode in production.
PORT=3000

REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-in-production
# Production web (Vercel) + optional preview URLs, comma-separated:
CLIENT_ORIGIN=https://aigdplatform.vercel.app

# Optional: PostgreSQL (if you use pg in code)
DATABASE_URL=

# MongoDB Atlas — connection string ONLY on the server / Render (never in Expo).
# Use either name (code accepts both). Prefer a database path at the end of the host:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ai-gd-platform?retryWrites=true&w=majority&appName=Cluster0
# If the URI has no path, the server uses MONGO_DB_NAME (default: ai-gd-platform) so data is not stored only under `test`.
# MONGODB_URI=same-as-above
# MONGO_DB_NAME=ai-gd-platform
