# Server
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# whisper.cpp (https://github.com/ggerganov/whisper.cpp)
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=
WHISPER_TIMEOUT_SECONDS=120

# faster-whisper (default STT when whisper.cpp is not configured)
FASTER_WHISPER_MODEL=small.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=5
FASTER_WHISPER_LANGUAGE=en
FASTER_WHISPER_VAD_FILTER=true
FASTER_WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

# Ollama (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_NUM_PREDICT=60

# Piper TTS (https://github.com/rhasspy/piper) — voice: en_US-lessac-medium
# Install: .\scripts\install-piper.ps1
# IMPORTANT (Windows): use piper.exe inside the folder that contains espeak-ng.dll
PIPER_BIN=./bin/piper/piper/piper.exe
PIPER_MODEL_PATH=./voices/en_US-lessac-medium.onnx
PIPER_LENGTH_SCALE=1.1
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8
PIPER_TIMEOUT_SECONDS=45

# Sessions & temp audio
SESSIONS_DIR=./sessions
TEMP_AUDIO_DIR=./temp_audio
MOCK_AI_PIPELINE=false

# Logging
LOG_LEVEL=INFO
